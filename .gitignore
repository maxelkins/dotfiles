.DS_Store
/node_modules/
/.build/

# Herdr runtime state
home/.config/herdr/*.log
home/.config/herdr/session*.json
home/.config/herdr/plugins.json
home/.config/herdr/plugins/
home/.config/herdr/.plugins.lock

# Pi: publish only reviewed paths. Pi writes auth, sessions, models, and its
# own settings.json beside these, so a new file stays untracked until it is
# listed here. (dot copies templates/pi/settings.json there once.)
home/.pi/agent/*
!home/.pi/agent/AGENTS.md
!home/.pi/agent/tsconfig.json
!home/.pi/agent/zentui.json
!home/.pi/agent/themes/
home/.pi/agent/themes/*
!home/.pi/agent/themes/*.json
!home/.pi/agent/extensions/
home/.pi/agent/extensions/**
!home/.pi/agent/extensions/**/
!home/.pi/agent/extensions/**/*.ts
home/.pi/agent/extensions/**/node_modules/
home/.pi/todos/
home/.pi/.pi/

# Agent skill runtime files
home/.agents/skills/*/node_modules/

# Local secrets
home/.zshrc.local
.env
.env.*
!.env.example
.envrc
.netrc

# Private keys and credential exports, anywhere
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
credentials*.json
home/.config/*/secrets.*

# Claude Code agent worktrees.
.claude/worktrees/
