.DS_Store
/node_modules/
/.build/

# Herdr runtime state
home/.config/herdr/*.log
home/.config/herdr/session*.json
home/.config/herdr/plugins.json
home/.config/herdr/plugins/
home/.config/herdr/.plugins.lock

# Pi runtime and secrets
# Pi owns its settings file; dot copies templates/pi/settings.json there once.
# Ignored so a stale link on another machine cannot write it into the repo.
home/.pi/agent/settings.json
home/.pi/agent/auth.json
home/.pi/agent/mcp-auth.json
home/.pi/agent/mcp.json
home/.pi/agent/models.json
home/.pi/agent/sessions/
home/.pi/agent/node_modules/
home/.pi/todos/
home/.pi/.pi/

# Agent skill runtime files
home/.agents/skills/*/node_modules/

# Local secrets
home/.zshrc.local
.env
.envrc
home/.config/*/secrets.*
