# Third-party apt repositories for packages in packages/bundle.linux.
# Added by: dot setup and dot upgrade, before any bundle package is installed.
#
# One block per repository. The block name names the files dot owns:
# /etc/apt/keyrings/<name>.asc (or .gpg) and /etc/apt/sources.list.d/<name>.list.
#
#   [name]
#   key         = <https URL>    Signing key: ASCII-armored, or binary when
#                                the URL ends in .gpg.
#   fingerprint = <40 hex> ...   Every primary-key fingerprint in the key file,
#                                uppercase, space-separated. dot refuses a key
#                                file that holds any other set of keys.
#   source      = <uri> <suite> [components]
#                                The rest of the deb line after signed-by.

# Claude Code CLI (Anthropic). Fingerprint from the "Binary integrity" section
# of https://code.claude.com/docs/en/setup. `stable` runs about a week behind
# and skips releases with major regressions; `latest` gets every release:
#   https://downloads.claude.ai/claude-code/apt/latest latest main
[claude-code]
key         = https://downloads.claude.ai/keys/claude-code.asc
fingerprint = 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
source      = https://downloads.claude.ai/claude-code/apt/stable stable main

# GitHub CLI (official). Ubuntu's own gh 2.45/2.46 is broken against current
# GitHub APIs. Fingerprints from https://github.com/cli/cli/blob/trunk/docs/install_linux.md
[github-cli]
key         = https://cli.github.com/packages/githubcli-archive-keyring.gpg
fingerprint = 2C6106201985B60E6C7AC87323F3D4EA75716059 7F38BBB59D064DBCB3D84D725612B36462313325
source      = https://cli.github.com/packages stable main
