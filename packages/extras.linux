# Pinned release binaries that dot installs on Linux into ~/.local/bin, for
# tools whose apt package is missing or too old. dot setup and dot upgrade
# install them; dot check reports any that are missing or outdated.
#
# One block per tool. The block name is the installed command name. Each
# field is `key = value` on one line, unquoted; {version} and {arch} expand in
# every value. Comments must be whole lines starting with #.
#
#   [name]
#   version      = X.Y.Z         Exact pinned release.
#   url          = https://...   Release asset, a .tar.gz or .tgz archive.
#   binary       = path          Executable inside the archive.
#   check        = args          Arguments that make the binary print its version.
#   expect       = v{version}    A word on the first line of that output must
#                                equal this exactly.
#   arch         = amd64=x86_64 arm64=aarch64
#                                Optional. The project's names for {arch}.
#                                Default: amd64 and arm64.
#   sha256.amd64 = <hex>         SHA-256 of the asset for each architecture.
#   sha256.arm64 = <hex>         Bump both hashes together with the version.

# Runtime manager for Pi's Node (scripts/lib/pi.sh). `asdf version` prints
# e.g. "v0.20.2 (revision cb72590)".
[asdf]
version      = 0.20.2
url          = https://github.com/asdf-vm/asdf/releases/download/v{version}/asdf-v{version}-linux-{arch}.tar.gz
binary       = asdf
check        = version
expect       = v{version}
sha256.amd64 = 6d45e6fab12f50a259b5643adf06a2e77af30a87300b4402440eda09af467a6d
sha256.arm64 = 356e135a608bdfba34038c1f18c4b82434d7b6d546e30dbf372c61baaa2f442c
