#!/usr/bin/env bash
set -euo pipefail

DOT_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$DOT_SCRIPT" ]]; do
  DOT_SCRIPT_DIR="$(cd -P "$(dirname "$DOT_SCRIPT")" && pwd)"
  DOT_SCRIPT="$(readlink "$DOT_SCRIPT")"
  [[ "$DOT_SCRIPT" == /* ]] || DOT_SCRIPT="${DOT_SCRIPT_DIR}/${DOT_SCRIPT}"
done

DOT_ROOT="$(cd -P "$(dirname "$DOT_SCRIPT")" && pwd)"
DOT_HOME_DIR="${DOT_ROOT}/home"
readonly DOT_SCRIPT DOT_ROOT DOT_HOME_DIR
export DOT_ROOT DOT_HOME_DIR

# shellcheck source=scripts/lib/common.sh
source "${DOT_ROOT}/scripts/lib/common.sh"
# shellcheck source=scripts/lib/brew.sh
source "${DOT_ROOT}/scripts/lib/brew.sh"
# shellcheck source=scripts/lib/stow.sh
source "${DOT_ROOT}/scripts/lib/stow.sh"
# shellcheck source=scripts/lib/pi.sh
source "${DOT_ROOT}/scripts/lib/pi.sh"
# shellcheck source=scripts/lib/doctor.sh
source "${DOT_ROOT}/scripts/lib/doctor.sh"

print_help() {
  cat <<'HELP'
Usage: dot [command]

Commands:
  setup [profile]         Set up this Mac using base, personal, or work packages
  upgrade                 Upgrade everything managed by this repository
  check                   Run read-only health checks
  apply home [option]     Reconcile managed home links
  apply macos             Apply macOS preferences
  apply dock              Configure Dock applications
  help                    Show this help

Options:
  --archive-legacy-skills Archive old Pi skill copies before applying home links

Run dot without a command to open the interactive menu.
HELP
}

cmd_setup() {
  local requested_profile=""
  local archive_legacy_skills=0
  local failures=0

  while (( $# > 0 )); do
    case "$1" in
      base|personal|work)
        if [[ -n "$requested_profile" ]]; then
          error "Only one package profile may be selected"
          print_summary "Setup did not start"
          print_action_required "Run: dot setup [base|personal|work]"
          return 1
        fi
        requested_profile="$1"
        shift
        ;;
      --archive-legacy-skills)
        archive_legacy_skills=1
        shift
        ;;
      *)
        error "Unknown setup option: $1"
        print_summary "Setup did not start"
        print_action_required "Run: dot help"
        return 1
        ;;
    esac
  done

  info "Setting up packages, Pi, shell tools, managed links, and repository hooks"
  if ! require_macos; then
    print_summary "Setup failed before changes were made"
    print_action_required "Run this command on macOS"
    return 1
  fi

  local profile
  if ! profile="$(choose_profile_for_setup "$requested_profile")"; then
    print_summary "Setup failed because the package profile is invalid"
    print_action_required "Run: dot setup [base|personal|work]"
    return 1
  fi
  save_profile "$profile"

  local homebrew_ready=1
  if ! install_homebrew; then
    homebrew_ready=0
    ((failures += 1))
  fi

  if (( homebrew_ready == 1 )); then
    install_packages || ((failures += 1))
  else
    skipped "Package installation requires Homebrew"
  fi

  install_pi || ((failures += 1))

  info "Installing shell dependencies"
  if run_prefixed Shell bash "${DOT_ROOT}/scripts/ohmyzsh.sh"; then
    success "Shell dependencies are installed"
  else
    error "Shell dependency installation failed"
    ((failures += 1))
  fi

  stow_home "$archive_legacy_skills" || ((failures += 1))
  link_dot_command || ((failures += 1))
  configure_git_hooks || ((failures += 1))

  if (( failures > 0 )); then
    print_summary "Setup completed with $failures failed stage(s)"
    print_action_required "Fix the errors above, then retry: dot setup $profile"
    return 1
  fi

  print_summary "Setup completed successfully"
  print_next_action "Restart the terminal, then run: dot check"
}

cmd_upgrade() {
  if ! require_no_args upgrade "$@"; then
    print_summary "Upgrade did not start"
    print_action_required "Run: dot upgrade"
    return 1
  fi
  local failures=0
  local warnings=0
  local repo_status=0

  info "Upgrading repository files, packages, Pi, managed links, and health checks"

  if ! repository_is_clean "$DOT_ROOT"; then
    error "Repository has uncommitted changes"
    print_summary "Upgrade stopped before making changes"
    print_action_required "Commit or stash changes shown by: git -C $DOT_ROOT status --short" "Then run: dot upgrade"
    return 1
  fi

  if update_repository "$DOT_ROOT"; then
    :
  else
    repo_status=$?
    if (( repo_status == 2 )); then
      ((warnings += 1))
    else
      ((failures += 1))
    fi
  fi

  update_packages || ((failures += 1))
  install_pi || ((failures += 1))
  stow_home || ((failures += 1))
  configure_git_hooks || ((failures += 1))

  info "Verifying the upgraded setup"
  if ! run_doctor embedded; then
    ((failures += 1))
  fi

  if (( failures > 0 )); then
    print_summary "Upgrade completed with $failures failed stage(s) and $warnings warning(s)"
    print_action_required "Resolve the failures above, then retry: dot upgrade"
    return 1
  fi

  if (( warnings > 0 )); then
    local branch
    branch="$(git -C "$DOT_ROOT" branch --show-current)"
    print_summary "Upgrade completed with $warnings warning(s); managed tools are healthy"
    print_action_required "Configure repository updates: git -C $DOT_ROOT push -u origin ${branch:-<branch>}"
    return 0
  fi

  print_summary "Upgrade completed successfully; no action is required"
}

cmd_check() {
  if ! require_no_args check "$@"; then
    print_summary "Health checks did not start"
    print_action_required "Run: dot check"
    return 1
  fi
  info "Checking tools, packages, managed links, Pi, and shell dependencies"
  run_doctor
}

cmd_apply() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    error "Usage: dot apply <home|macos|dock>"
    print_summary "No configuration was applied"
    print_action_required "Run: dot apply <home|macos|dock>"
    return 1
  fi
  shift

  case "$target" in
    home)
      local archive_legacy_skills=0
      while (( $# > 0 )); do
        case "$1" in
          --archive-legacy-skills) archive_legacy_skills=1 ;;
          *)
            error "Unknown apply home option: $1"
            print_summary "Managed home links were not changed"
            print_action_required "Run: dot apply home [--archive-legacy-skills]"
            return 1
            ;;
        esac
        shift
      done
      info "Reconciling managed home links with conflict backups"
      if stow_home "$archive_legacy_skills"; then
        print_summary "Managed home links were applied successfully"
        print_next_action "Run: dot check"
      else
        print_summary "Managed home links could not be applied"
        print_action_required "Fix the error above, then retry: dot apply home"
        return 1
      fi
      ;;
    macos)
      if ! require_no_args "apply macos" "$@"; then
        print_summary "macOS preferences were not changed"
        print_action_required "Run: dot apply macos"
        return 1
      fi
      info "Applying opt-in macOS preferences"
      if ! require_macos; then
        print_summary "macOS preferences were not changed"
        print_action_required "Run this command on macOS"
        return 1
      fi
      if run_prefixed macOS bash "${DOT_ROOT}/scripts/macos.sh"; then
        print_summary "macOS preferences were applied successfully"
        print_next_action "Restart affected applications or log out if a setting has not refreshed"
      else
        print_summary "Some macOS preferences could not be applied"
        print_action_required "Fix the error above, then retry: dot apply macos"
        return 1
      fi
      ;;
    dock)
      if ! require_no_args "apply dock" "$@"; then
        print_summary "Dock configuration was not changed"
        print_action_required "Run: dot apply dock"
        return 1
      fi
      info "Applying the opt-in Dock configuration"
      if ! require_macos; then
        print_summary "Dock configuration was not changed"
        print_action_required "Run this command on macOS"
        return 1
      fi
      if run_prefixed Dock bash "${DOT_ROOT}/scripts/dock.sh"; then
        print_summary "Dock configuration was applied successfully; no action is required"
      else
        print_summary "Dock configuration could not be applied"
        print_action_required "Fix the error above, then retry: dot apply dock"
        return 1
      fi
      ;;
    *)
      error "Unknown apply target: $target"
      print_summary "No configuration was applied"
      print_action_required "Run: dot apply <home|macos|dock>"
      return 1
      ;;
  esac
}

cmd_change_profile() {
  local profile="$1"
  if save_profile "$profile"; then
    print_summary "Package profile changed to $profile"
    print_action_required "Install the selected packages: dot upgrade"
  fi
}

run_menu_command() {
  if ! dispatch_command "$@"; then
    printf '\nThe operation did not complete successfully.\n' >&2
  fi
}

apply_menu() {
  local choice
  printf '\nApply configuration\n\n'
  printf '1) Managed home links\n'
  printf '2) macOS preferences\n'
  printf '3) Dock configuration\n'
  printf 'b) Back\n\n'
  printf 'Choose an operation: '
  IFS= read -r choice || return 0

  case "$choice" in
    1) run_menu_command apply home ;;
    2) run_menu_command apply macos ;;
    3) run_menu_command apply dock ;;
    b|B|'') return 0 ;;
    *) warn "Invalid choice '$choice'; choose 1, 2, 3, or b" ;;
  esac
}

profile_menu() {
  local choice profile
  printf '\nChange package profile\n\n'
  printf '1) base\n'
  printf '2) personal\n'
  printf '3) work\n'
  printf 'b) Back\n\n'
  printf 'Choose a profile: '
  IFS= read -r choice || return 0

  case "$choice" in
    1) profile=base ;;
    2) profile=personal ;;
    3) profile=work ;;
    b|B|'') return 0 ;;
    *) warn "Invalid choice '$choice'; choose 1, 2, 3, or b"; return 0 ;;
  esac
  cmd_change_profile "$profile"
}

interactive_menu() {
  local choice profile

  while true; do
    profile="$(current_profile 2>/dev/null || printf 'unknown')"
    printf '\nDotfiles\n'
    printf 'Current package profile: %s\n\n' "$profile"
    printf '1) Set up this Mac\n'
    printf '2) Upgrade everything\n'
    printf '3) Check health\n'
    printf '4) Apply configuration\n'
    printf '5) Change package profile\n'
    printf 'q) Quit\n\n'
    printf 'Choose an operation: '
    IFS= read -r choice || return 0

    case "$choice" in
      1) run_menu_command setup ;;
      2) run_menu_command upgrade ;;
      3) run_menu_command check ;;
      4) apply_menu ;;
      5) profile_menu ;;
      q|Q) return 0 ;;
      *) warn "Invalid choice '$choice'; choose 1-5 or q" ;;
    esac
  done
}

dispatch_command() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    setup) cmd_setup "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    check) cmd_check "$@" ;;
    apply) cmd_apply "$@" ;;
    help|-h|--help) print_help ;;
    *)
      error "Unknown command: $command"
      print_summary "No operation was run"
      print_action_required "Run: dot help"
      return 1
      ;;
  esac
}

main() {
  if (( $# == 0 )); then
    if [[ -t 0 ]]; then
      interactive_menu
    else
      print_help
    fi
    return
  fi

  dispatch_command "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
