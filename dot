#!/usr/bin/env bash
# dot: set up and maintain this machine from this repository.
#
# home/ mirrors $HOME and is linked with GNU Stow. Packages live in packages/.
# Everything else is in this file, top to bottom: output helpers, packages,
# Linux tools, Pi, skills, links, then the commands. Keep it bash 3.2 safe:
# macOS runs it with /bin/bash.
# shellcheck disable=SC2088 # "~/" in messages is display text
set -euo pipefail

# Resolve the repository through the ~/.local/bin/dot symlink.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ "$self" == /* ]] || self="${dir}/${self}"
done
DOT_ROOT="$(cd -P "$(dirname "$self")" && pwd)"
HOME_DIR="${DOT_ROOT}/home"
PACKAGES="${DOT_ROOT}/packages"
PROFILE_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles/profile"
PI_PACKAGE="@earendil-works/pi-coding-agent"
SKILL_AGENTS=(pi claude-code)
unset self dir

export PATH="${HOME}/.local/bin:${ASDF_DATA_DIR:-${HOME}/.asdf}/shims:${PATH}"

# ─── Output ──────────────────────────────────────────────────────────────────

color() {
  local code="$1"
  shift
  if [[ -t 1 && "${TERM:-}" != dumb && -z "${NO_COLOR+x}" ]]; then
    printf '\033[%sm%s\033[0m' "$code" "$*"
  else
    printf '%s' "$*"
  fi
}

step() { printf '\n%s\n' "$(color '1;36' "==> $*")"; }
ok() { printf '  %s %s\n' "$(color 32 '✓')" "$*"; }
warn() { printf '  %s %s\n' "$(color 33 '!')" "$*" >&2; }
err() { printf '  %s %s\n' "$(color 31 '✗')" "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
is_macos() { [[ "$(uname -s)" == Darwin ]]; }
is_linux() { [[ "$(uname -s)" == Linux ]]; }

# Run each named step and keep going after a failure. Sets FAILED.
run_all() {
  local fn
  FAILED=()
  for fn in "$@"; do
    "$fn" || FAILED+=("$fn")
  done
}

finish() {
  if (( ${#FAILED[@]} > 0 )); then
    printf '\n%s %s\n' "$(color '1;31' 'Failed:')" "${FAILED[*]}"
    return 1
  fi
  printf '\n%s\n' "$(color '1;32' "$1")"
}

# ─── Headless ────────────────────────────────────────────────────────────────
# `dot --headless` (or DOT_HEADLESS=1) never waits for input: for agent boxes
# and SSH sessions. Tools that would prompt fail instead.

headless() { [[ "${DOT_HEADLESS:-0}" == 1 ]]; }

configure_headless() {
  case "${DOT_HEADLESS:-}" in
    '' | 0 | false | no) DOT_HEADLESS=0 ;;
    1 | true | yes)
      export DOT_HEADLESS=1 DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a \
        NONINTERACTIVE=1 GIT_TERMINAL_PROMPT=0
      if [[ -z "${GIT_SSH_COMMAND:-}" && -z "${GIT_SSH:-}" ]]; then
        export GIT_SSH_COMMAND='ssh -o BatchMode=yes'
      fi
      ;;
    *) err "DOT_HEADLESS must be 1 or 0, not '${DOT_HEADLESS}'"; return 1 ;;
  esac
}

# ─── Profile (macOS) ─────────────────────────────────────────────────────────
# base, personal, or work: picks packages/bundle.<profile> on top of
# packages/bundle. Stored outside the repository because it is machine state.

profile() {
  local value=base
  [[ ! -f "$PROFILE_FILE" ]] || IFS= read -r value <"$PROFILE_FILE" || true
  printf '%s\n' "${value:-base}"
}

save_profile() {
  case "$1" in
    base | personal | work) ;;
    *) err "Profile must be base, personal, or work, not '$1'"; return 1 ;;
  esac
  mkdir -p "$(dirname "$PROFILE_FILE")"
  printf '%s\n' "$1" >"$PROFILE_FILE"
}

brewfiles() {
  printf '%s\n' "${PACKAGES}/bundle"
  [[ "$(profile)" == base ]] || printf '%s\n' "${PACKAGES}/bundle.$(profile)"
}

# ─── Packages ────────────────────────────────────────────────────────────────

load_brew() {
  have brew && return 0
  local brew
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$brew" ]]; then
      eval "$("$brew" shellenv)"
      return 0
    fi
  done
  return 1
}

as_root() {
  if [[ "$(id -u)" == 0 ]]; then
    "$@"
  elif headless || [[ ! -t 0 ]]; then
    sudo -n "$@"
  else
    sudo "$@"
  fi
}

apt_get() {
  as_root env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a apt-get -y \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}

list_file() {
  sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$1"
}

apt_packages() {
  list_file "${PACKAGES}/bundle.linux" | awk '{ print $1 }'
}

install_packages() {
  step "Packages"
  if is_macos; then
    if ! load_brew; then
      local script
      script="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" ||
        { err "Could not download the Homebrew installer"; return 1; }
      NONINTERACTIVE=1 /bin/bash -c "$script" || return 1
      load_brew || { err "Homebrew installed but is not on PATH"; return 1; }
    fi
    local file failed=0
    while IFS= read -r file; do
      brew bundle --file="$file" || failed=1
    done < <(brewfiles)
    return "$failed"
  fi

  if [[ "$(id -u)" != 0 ]] && ! sudo -n true 2>/dev/null && { headless || [[ ! -t 0 ]]; }; then
    err "sudo needs a password; configure passwordless sudo or run dot from a terminal"
    return 1
  fi
  # shellcheck disable=SC2046 # one package name per word
  apt_get update && apt_get install --no-install-recommends $(apt_packages)
}

update_packages() {
  if is_macos; then
    load_brew && brew update || return 1
    install_packages
  else
    install_packages || return 1
    # shellcheck disable=SC2046
    apt_get install --only-upgrade --no-install-recommends $(apt_packages)
  fi
}

check_packages() {
  if is_macos; then
    load_brew || { warn "Homebrew is missing"; return 1; }
    local file failed=0
    while IFS= read -r file; do
      brew bundle check --no-upgrade --file="$file" >/dev/null || { warn "$(basename "$file") has missing packages"; failed=1; }
    done < <(brewfiles)
    return "$failed"
  fi
  local pkg failed=0
  for pkg in $(apt_packages); do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || { warn "apt package $pkg is missing"; failed=1; }
  done
  return "$failed"
}

# ─── Linux tools ─────────────────────────────────────────────────────────────
# packages/install.linux lists tools apt lacks: `<command> <install command>`.
# Setup runs an install command when <command> is not on PATH; update runs all.

# install_release <latest-url> <asset-url> <binary>
# <latest-url> must redirect to a URL ending in the release tag. {version}
# (the tag without a leading v) and {arch} (amd64 or arm64) expand in
# <asset-url> and <binary>. Extracts the .tar.gz asset and installs <binary>,
# a path inside it, into ~/.local/bin.
install_release() {
  local latest="$1" url="$2" binary="$3" tag version arch tmp status=0
  tag="$(curl -fsSI -o /dev/null -w '%{redirect_url}' "$latest")" || tag=""
  tag="${tag%/}"
  version="${tag##*/}"
  version="${version#v}"
  [[ -n "$version" ]] || { err "No release found at $latest"; return 1; }
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) err "Unsupported architecture: $(uname -m)"; return 1 ;;
  esac
  url="${url//'{version}'/$version}"
  url="${url//'{arch}'/$arch}"
  binary="${binary//'{version}'/$version}"
  binary="${binary//'{arch}'/$arch}"

  tmp="$(mktemp -d)"
  mkdir -p "${HOME}/.local/bin"
  if curl -fsSL "$url" | tar -xz -C "$tmp" &&
    install -m 0755 "${tmp}/${binary}" "${HOME}/.local/bin/${binary##*/}"; then
    ok "${binary##*/} $version"
  else
    err "Could not install ${binary##*/} from $url"
    status=1
  fi
  rm -rf "$tmp"
  return "$status"
}

install_linux_tools() {
  local mode="${1:-missing}" name cmd failed=0
  is_linux || return 0
  step "Linux tools"
  while read -r name cmd; do
    if [[ "$mode" == missing ]] && have "$name"; then
      ok "$name is installed"
      continue
    fi
    (eval "$cmd") </dev/null || { err "$name failed to install"; failed=1; }
  done < <(list_file "${PACKAGES}/install.linux")
  return "$failed"
}

update_linux_tools() { install_linux_tools all; }

check_linux_tools() {
  is_linux || return 0
  local name _ failed=0
  while read -r name _; do
    have "$name" || { warn "$name is not on PATH"; failed=1; }
  done < <(list_file "${PACKAGES}/install.linux")
  return "$failed"
}

# ─── Shell ───────────────────────────────────────────────────────────────────
# macOS uses zsh with Oh My Zsh. Linux keeps bash and gets one line at the top
# of ~/.bashrc and ~/.profile that loads ~/.config/dotfiles/env.sh (PATH). It
# must come first because Ubuntu's ~/.bashrc returns early when not interactive.

# shellcheck disable=SC2016 # expanded by the shell that reads the file
SHELL_HOOK='if [ -f "$HOME/.config/dotfiles/env.sh" ]; then . "$HOME/.config/dotfiles/env.sh"; fi'

install_shell() {
  step "Shell"
  if is_macos; then
    [[ -d "${HOME}/.oh-my-zsh" ]] && { ok "Oh My Zsh is installed"; return 0; }
    local script
    script="$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" ||
      { err "Could not download Oh My Zsh"; return 1; }
    sh -c "$script" -- --unattended --keep-zshrc
    return
  fi
  local file
  for file in "${HOME}/.bashrc" "${HOME}/.profile"; do
    grep -qF '.config/dotfiles/env.sh' "$file" 2>/dev/null && continue
    { printf '%s\n' "$SHELL_HOOK"; cat "$file" 2>/dev/null || true; } >"${file}.dot-tmp"
    cat "${file}.dot-tmp" >"$file" && rm -f "${file}.dot-tmp"
  done
  ok "~/.bashrc and ~/.profile load the dot PATH"
}

check_shell() {
  if is_macos; then
    [[ -d "${HOME}/.oh-my-zsh" ]] || { warn "Oh My Zsh is missing"; return 1; }
    return 0
  fi
  grep -qF '.config/dotfiles/env.sh' "${HOME}/.bashrc" 2>/dev/null || { warn "~/.bashrc does not load the dot PATH"; return 1; }
}

# ─── Pi ──────────────────────────────────────────────────────────────────────
# Pi runs on its own Node, pinned in ~/.config/pi-runtime/.tool-versions, so a
# project's .tool-versions cannot swap it out. ~/.local/bin/pi starts it.

pi_node_dir() {
  (cd "${HOME_DIR}/.config/pi-runtime" && asdf where nodejs) 2>/dev/null
}

install_pi() {
  step "Pi"
  have asdf || { err "asdf is required to install Pi"; return 1; }
  asdf plugin list 2>/dev/null | grep -qx nodejs || asdf plugin add nodejs || return 1
  (cd "${HOME_DIR}/.config/pi-runtime" && asdf install nodejs) || return 1
  local node_dir
  node_dir="$(pi_node_dir)" || return 1
  PATH="${node_dir}/bin:${PATH}" npm install -g --no-fund --no-audit "$PI_PACKAGE" || return 1
  ok "Pi $("${HOME_DIR}/.local/bin/pi" --version 2>/dev/null)"
}

check_pi() {
  "${HOME_DIR}/.local/bin/pi" --version >/dev/null 2>&1 || { warn "Pi is not installed; run: dot setup"; return 1; }
}

# Copy Pi's local config templates once. Pi owns these files afterwards.
seed_pi_config() {
  local dir="${HOME}/.pi/agent"
  mkdir -p "$dir" || return 1
  if [[ ! -e "${dir}/settings.json" && ! -L "${dir}/settings.json" ]]; then
    cp "${DOT_ROOT}/templates/pi/settings.json" "${dir}/settings.json" || return 1
  fi
  if [[ ! -e "${dir}/mcp.json" && ! -L "${dir}/mcp.json" ]]; then
    (umask 077 && cp "${DOT_ROOT}/templates/pi/mcp.example.json" "${dir}/mcp.json") || return 1
  fi
}

# ─── Skills ──────────────────────────────────────────────────────────────────
# Your own skills live in home/.agents/skills and are linked like any config.
# Third-party skills are listed in home/.agents/.skill-lock.json and installed
# by the skills CLI into ~/.agents/skills, for Pi and Claude Code.

skills_cli() {
  local node_dir
  node_dir="$(pi_node_dir)" || { err "Pi's Node is missing; run: dot setup"; return 1; }
  PATH="${node_dir}/bin:${PATH}" npx -y skills@latest "$@"
}

# Print "<name>\t<install source>" for each skill in the lock file. A skill kept
# outside the repository's default skills/ folder is installed from that folder,
# because the same name can exist once per host (apps/kiro-cli, apps/qwen-code).
locked_skills() {
  local node_dir
  node_dir="$(pi_node_dir)" || return 1
  # shellcheck disable=SC2016 # template literal, not shell expansion
  "${node_dir}/bin/node" -e '
    const lock = require(process.argv[1]).skills;
    for (const [name, s] of Object.entries(lock)) {
      const dir = (s.skillPath || "").includes("/") ? s.skillPath.replace(/\/[^/]*$/, "") : "";
      const install = dir && !dir.startsWith("skills/") ? `${s.source}/${dir}` : s.sourceUrl || s.source;
      console.log(name + "\t" + install);
    }
  ' "${HOME_DIR}/.agents/.skill-lock.json"
}

install_skills() {
  step "Skills"
  local skills name source failed=0
  skills="$(locked_skills)" || { err "Could not read the skill lock file"; return 1; }
  while IFS=$'\t' read -r name source; do
    if [[ -f "${HOME}/.agents/skills/${name}/SKILL.md" ]]; then
      ok "$name"
      continue
    fi
    skills_cli add "$source" --global --skill "$name" --agent "${SKILL_AGENTS[@]}" --yes </dev/null || failed=1
  done <<<"$skills"
  return "$failed"
}

update_skills() {
  install_skills || return 1
  skills_cli update --global --yes </dev/null
}

check_skills() {
  local skills name _ failed=0
  skills="$(locked_skills)" || { warn "Could not read the skill lock file"; return 1; }
  while read -r name _; do
    [[ -f "${HOME}/.agents/skills/${name}/SKILL.md" ]] || { warn "Skill $name is not installed"; failed=1; }
  done <<<"$skills"
  return "$failed"
}

# ─── Links ───────────────────────────────────────────────────────────────────
# Stow links each file under home/ into $HOME. Anything already in the way is
# moved to ~/.local/state/dotfiles/backups first.

stow_ignores() {
  printf '%s\n' '--ignore=\.DS_Store'
  is_macos || printf '%s\n' '--ignore=^Library'
}

managed_files() {
  # Files and tracked symlinks (e.g. home/.pi/agent/AGENTS.md).
  local prune=()
  is_macos || prune=(-path "${HOME_DIR}/Library" -prune -o)
  find "$HOME_DIR" ${prune[@]+"${prune[@]}"} \( -type f -o -type l \) ! -name .DS_Store -print
}

# Move a path under $HOME out of the way, into the backup folder.
backup_path() {
  local path="$1"
  DOT_BACKUP_DIR="${DOT_BACKUP_DIR:-${HOME}/.local/state/dotfiles/backups/$(date +%Y%m%d-%H%M%S)}"
  mkdir -p "$(dirname "${DOT_BACKUP_DIR}/${path#"${HOME}"/}")" || return 1
  mv "$path" "${DOT_BACKUP_DIR}/${path#"${HOME}"/}" || return 1
  warn "Moved ~/${path#"${HOME}"/} to $DOT_BACKUP_DIR"
}

# Absolute path a link points at, resolved without requiring the target to exist.
link_target() {
  local dir target part out=""
  dir="$(cd "$(dirname "$1")" && pwd -P)" || return 1
  target="$(readlink "$1")" || return 1
  [[ "$target" == /* ]] || target="${dir}/${target}"
  local IFS=/
  for part in $target; do
    case "$part" in
      ''|.) ;;
      ..) out="${out%/*}" ;;
      *) out="${out}/${part}" ;;
    esac
  done
  printf '%s\n' "${out:-/}"
}

# A deleted repo file leaves its Stow link behind, pointing at nothing: a path
# that looks installed but is not. Drop links into this repo whose target is
# gone. Links to anywhere else are left alone.
prune_links() {
  local dir link
  while IFS= read -r link; do
    [[ -e "$link" ]] && continue
    case "$(link_target "$link")" in
      "${HOME_DIR}"/*) rm -f "$link" && warn "Removed stale link ~/${link#"${HOME}"/}" ;;
    esac
  done < <(
    # $HOME itself, then each top-level folder of home/ once, all the way down.
    find "$HOME" -mindepth 1 -maxdepth 1 -type l -print
    while IFS= read -r dir; do
      is_macos || [[ "$dir" != "${HOME_DIR}/Library" ]] || continue
      [[ -d "${HOME}/${dir#"${HOME_DIR}"/}" ]] && find "${HOME}/${dir#"${HOME_DIR}"/}" -type l -print
    done < <(find "$HOME_DIR" -mindepth 1 -maxdepth 1 -type d -print)
  )
}

link_home() {
  step "Links"
  have stow || { err "GNU Stow is required; run: dot setup"; return 1; }
  local source target ancestor
  while IFS= read -r source; do
    target="${HOME}/${source#"${HOME_DIR}"/}"
    # A file or symlink in the way of a managed path.
    if [[ ! "$target" -ef "$source" ]] && { [[ -e "$target" ]] || [[ -L "$target" ]]; }; then
      backup_path "$target" || return 1
    fi
    # A file in the way of a managed directory: Stow cannot traverse it, so
    # walk every ancestor up to $HOME and back the conflict up once.
    ancestor="$(dirname "$target")"
    while [[ "$ancestor" != "$HOME" && "$ancestor" != "/" ]]; do
      if { [[ -e "$ancestor" ]] || [[ -L "$ancestor" ]]; } && [[ ! -d "$ancestor" ]]; then
        backup_path "$ancestor" || return 1
      fi
      ancestor="$(dirname "$ancestor")"
    done
  done < <(managed_files)

  local ignores=()
  while IFS= read -r source; do ignores+=("$source"); done < <(stow_ignores)
  prune_links
  stow --restow --no-folding "${ignores[@]}" --dir "$DOT_ROOT" --target "$HOME" home || return 1

  # Claude Code reads ~/.claude/skills; point it at your own skills too.
  mkdir -p "${HOME}/.claude/skills"
  for source in "${HOME_DIR}/.agents/skills"/*/; do
    target="${HOME}/.claude/skills/$(basename "$source")"
    [[ -e "$target" && ! -L "$target" ]] || ln -sfn "../../.agents/skills/$(basename "$source")" "$target"
  done

  seed_pi_config || return 1
  mkdir -p "${HOME}/.local/bin"
  ln -sfn "${DOT_ROOT}/dot" "${HOME}/.local/bin/dot"
  ok "Home links point to $HOME_DIR"
}

check_links() {
  local source target failed=0
  while IFS= read -r source; do
    target="${HOME}/${source#"${HOME_DIR}"/}"
    [[ "$target" -ef "$source" ]] || { warn "~/${target#"${HOME}"/} is not linked"; failed=1; }
  done < <(managed_files)
  return "$failed"
}

configure_repo() {
  git -C "$DOT_ROOT" config core.hooksPath .githooks
}

pull_repo() {
  step "Repository"
  if [[ -n "$(git -C "$DOT_ROOT" status --porcelain)" ]]; then
    warn "Uncommitted changes; skipping git pull"
  elif ! git -C "$DOT_ROOT" rev-parse '@{upstream}' >/dev/null 2>&1; then
    warn "No upstream branch; skipping git pull"
  else
    git -C "$DOT_ROOT" pull --ff-only
  fi
}

# ─── Commands ────────────────────────────────────────────────────────────────

cmd_setup() {
  if [[ $# -gt 0 ]] && ! is_macos; then
    warn "Profiles only apply on macOS; ignoring '$1'"
  elif [[ $# -gt 0 ]]; then
    save_profile "$1" || return 1
  fi
  if is_macos; then
    printf 'Profile: %s\n' "$(profile)"
  fi
  # Links first: Pi's runtime pin and the skill lock are read from home/.
  run_all install_packages install_linux_tools install_shell link_home install_pi install_skills configure_repo
  finish "Setup complete. Open a new shell, then run: dot check"
}

cmd_update() {
  # pull_repo returns success for the intentional skips (dirty tree, no
  # upstream); a real pull failure is kept in the final status.
  run_all pull_repo update_packages update_linux_tools link_home install_pi update_skills
  finish "Everything is up to date"
}

cmd_check() {
  local name fn failed=0
  for name in packages:check_packages tools:check_linux_tools shell:check_shell \
    links:check_links pi:check_pi skills:check_skills; do
    fn="${name#*:}"
    if "$fn"; then ok "${name%%:*}"; else failed=1; fi
  done
  (( failed == 0 )) || { printf '\nRun: dot setup\n'; return 1; }
}

cmd_link() {
  link_home
}

macos_only() {
  is_macos || { err "dot $1 only runs on macOS"; return 1; }
}

usage() {
  cat <<'EOF'
Usage: dot [--headless] <command>

  setup [base|personal|work]  Install packages, tools, Pi, skills, and links.
                              The profile (macOS) picks an extra Brewfile.
  update                      Pull this repo, then upgrade everything.
  check                       Report anything setup has not done.
  link                        Link home/ into $HOME.
  macos                       Apply macOS preferences (opt-in).
  dock                        Set up the Dock (opt-in).

--headless (or DOT_HEADLESS=1) never prompts: for agent boxes and SSH.
EOF
}

main() {
  if [[ "${1:-}" == --headless ]]; then
    DOT_HEADLESS=1
    shift
  fi
  configure_headless
  local command="${1:-help}"
  shift || true
  case "$command" in
    setup) cmd_setup "$@" ;;
    update) cmd_update ;;
    check) cmd_check ;;
    link) cmd_link ;;
    macos) macos_only macos && bash "${DOT_ROOT}/scripts/macos.sh" ;;
    dock) macos_only dock && bash "${DOT_ROOT}/scripts/dock.sh" ;;
    help | -h | --help) usage ;;
    *) err "Unknown command: $command"; usage >&2; return 1 ;;
  esac
}

main "$@"
