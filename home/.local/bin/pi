#!/bin/sh
# Start Pi on its own Node (~/.config/pi-runtime/.tool-versions), so a
# project's .tool-versions cannot swap it out. Installed by: dot setup
set -eu
node_dir=$(cd "$HOME/.config/pi-runtime" && asdf where nodejs) || {
  echo "Pi's Node is not installed; run: dot setup" >&2
  exit 1
}
# Pi's updater must use the npm that belongs to its Node.
if [ "${1:-}" = update ]; then PATH="$node_dir/bin:$PATH"; export PATH; fi
exec "$node_dir/bin/node" "$node_dir/bin/pi" "$@"
