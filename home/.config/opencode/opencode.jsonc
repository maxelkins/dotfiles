{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode adapter. Harness-neutral assets live under ~/.agents:
  //   - skills are discovered from ~/.agents/skills (compatibility source;
  //     the entry below keeps the shared layer explicit)
  //   - global rules load via `instructions`
  // Never manage here: provider auth and session state live in
  // ~/.local/share/opencode (covered by the existing secrets rules).
  "skills": ["~/.agents/skills"],
  "instructions": ["~/.agents/AGENTS.md"],
}
